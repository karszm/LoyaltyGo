---
// ProgramCard — a truthful preview of the Wallet card the customer is about to receive.
// Ground is the merchant's own colour (or the neutral fallback brand.ts computed for one that
// hasn't picked one yet), logo top-left, program name, and the balance line every fresh card
// starts at. This is the one depicted physical object on the page, so — unlike page chrome —
// it's allowed its own edge and a shadow (see packages/design-tokens and the impeccable rule
// this project follows: shadows exist only for depicted objects, never for page structure).
import type { BrandModel } from "../lib/brand.ts";

interface Props {
  brand: BrandModel;
  // `PassLinks` (lib/api.ts, GET /card-links/:token) carries no points balance — a member
  // arriving via card recovery usually HAS points, so rendering `0 pkt` there would be a
  // fabrication, and a misleading one (reads as "your balance was wiped"). `null` omits the
  // balance row entirely, leaving the card a brand plate (logo + name only). Defaults to `0` so
  // [inviteCode].astro's fresh-signup card (where `0 pkt` is simply true) renders unchanged.
  balance?: number | null;
}

const { brand, balance = 0 } = Astro.props;
---

<div
  class="program-card"
  style={`--card-bg:${brand.backgroundColor};--card-ink:${brand.primaryInk};--card-ink-2:${brand.secondaryInk};--card-edge:${brand.edgeColor};`}
>
  <div class="program-card__logo">
    {/* Logo sits directly on the merchant's colour, deliberately with no white chip behind it:
       a chip would make every logo look fine here and different from how it actually renders
       in the real Wallet pass — this preview has to stay truthful, even when that means a
       merchant sees their own logo read badly on their own colour. */}
    {/* The monogram is ALWAYS rendered underneath, not swapped in on failure: Task 7 adds a
       CSP, and any script-src directive disables inline event handlers (onerror included —
       CSP hashes don't cover them without 'unsafe-hashes'), so there is no script-free way to
       react to a failed image load. Three real states, no JS in any of them:
         - no logo_url at all (both seed rows today, and the live path until the panel starts
           uploading one) -- no image tag is rendered, so the monogram is what shows. This is
           the case the monogram exists for.
         - logo loads -- .program-card__logo-img's own `background: var(--card-bg)` makes the
           image opaque (it matches the card, so it reads as no layer at all), fully covering
           the monogram underneath. A transparent PNG/wordmark then shows the card's own colour
           through its transparent regions, exactly like the real Wallet pass.
         - logo 404s -- the (still opaque) image box paints the card colour and covers the
           monogram anyway, so the slot goes quietly empty rather than showing a letter or a
           broken-image glyph. That's a deliberate trade, not an oversight: this is rare (the
           seed fixtures don't even have a logo_url to fail), and the program name is already
           rendered as text right beside it -- an empty slot is quieter than either alternative.
       It's not an edge case that logo_url is absent, though: the seed fixtures (SEEDA1/SEEDB1)
       both have logo_url = NULL, and while panel-api's publish check requires one going
       forward, nothing enforces that retroactively — so right now the no-logo path is live and
       common, not rare. */}
    <span class="program-card__monogram" aria-hidden="true">
      {brand.monogram}
    </span>
    {
      brand.logoUrl && (
        <img class="program-card__logo-img" src={brand.logoUrl} alt="" loading="eager" decoding="async" />
      )
    }
  </div>

  <div class="program-card__body">
    <p class="program-card__name">{brand.displayName}</p>
    {
      balance !== null && (
        <p class="program-card__balance">
          <span class="program-card__balance-label">Saldo</span>
          <span class="program-card__balance-value">{balance} <span class="program-card__balance-unit">pkt</span></span>
        </p>
      )
    }
  </div>
</div>

<style>
  .program-card {
    width: min(100%, 380px);
    aspect-ratio: 8 / 5; /* wallet-pass-ish proportions, not a page card */
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-8);
    border-radius: var(--radius-2xl);
    background: var(--card-bg);
    /* The edge is a `box-shadow` ring (0 0 0 1px), NOT a `border` — deliberately, so it paints
       OUTSIDE the box, against the actual page ground behind it, rather than being clipped
       under the card's own background like a border would be. That's what keeps a brand colour
       identical to the page ground (#08090a) from vanishing: brand.ts solves this ring's alpha
       specifically against that fixed page colour (see CARD_EDGE_COLOR), which only works if
       it's actually rendered against that colour, not the card's own arbitrary fill.
       The two shadow layers are indigo-tinted, not neutral black: on this dark page, a pure
       black shadow is nearly identical in luminance to the page itself and can't register at
       all — the tint is what makes it read as an intentional shadow rather than nothing. */
    box-shadow:
      0 0 0 1px var(--card-edge),
      0 2px 5px rgba(10, 8, 24, 0.5),
      0 18px 36px -14px rgba(18, 14, 40, 0.6);
    animation: card-enter 420ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes card-enter {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .program-card__logo {
    position: relative;
    width: 48px;
    height: 48px;
  }

  .program-card__logo-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    /* Opaque, matching the card: covers the monogram underneath completely (object-fit:
       contain never fills a box whose aspect ratio differs from the image, so without this
       the monogram would bleed through a transparent PNG or a non-square wordmark — nearly
       every real logo). A transparent region in the logo then shows the card's own colour,
       same as the real Wallet pass. */
    background: var(--card-bg);
  }

  .program-card__monogram {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    font-size: 26px;
    font-weight: 590;
    color: var(--card-ink);
  }

  .program-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .program-card__name {
    font-size: 17px;
    font-weight: 590;
    letter-spacing: -0.01em;
    color: var(--card-ink);
  }

  .program-card__balance {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .program-card__balance-label {
    font-size: 12px;
    font-weight: 590;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--card-ink-2);
  }

  .program-card__balance-value {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 28px;
    font-weight: 590;
    color: var(--card-ink);
  }

  .program-card__balance-unit {
    font-size: 16px;
    font-weight: 500;
  }
</style>
