---
// [inviteCode].astro — the page a customer lands on after scanning a merchant's printed QR
// code. GET /invites/:code has five customer-visible outcomes (task-7-brief.md); the pure
// mapInviteResult() does the branching so it's unit-tested without a browser, and this file
// only wires the result to a status code and a component.
//
// `active` renders ProgramCard (Task 6) inside the shared shell below; the join form and
// "Odzyskaj kartę" that also belong on that screen are Task 8's work, not this one's.
import Base from "../layouts/Base.astro";
import ProgramCard from "../components/ProgramCard.astro";
import StatusPanel from "../components/StatusPanel.astro";
import JoinForm from "../components/JoinForm.astro";
import { getInvite, joinProgram } from "../lib/api.ts";
import { deriveBrand } from "../lib/brand.ts";
import { mapInviteResult, mapJoinResult } from "../lib/invite-outcome.ts";
import type { JoinOutcome } from "../lib/invite-outcome.ts";

const { inviteCode } = Astro.params;
const result = await getInvite(inviteCode as string);
const outcome = mapInviteResult(result);

// Fields the customer typed, echoed back on a 422 — "nobody retypes a surname at a till"
// (task-8-brief.md). Empty on a fresh GET.
let formValues = { first_name: "", last_name: "", email: "" };
let joinOutcome: JoinOutcome | null = null;

// Task 8's join POST renders DIRECTLY from this same request — no redirect. A redirect to
// `?joined=1` would need a 200 GET to show the confirmation, and middleware.ts's cache rule
// grants s-maxage=60 to ANY 200 GET on this route regardless of query string: the next
// customer to scan the same QR code within that minute would get the shared CDN's cached copy
// of a DIFFERENT customer's confirmation. Rendering the POST's own response (whatever status
// it carries) never enters that cache at all, because middleware.ts's rule only ever applies
// to GET.
//
// POST only ever reaches the join call when the page's own GET-equivalent check above already
// says `active` — a POST against a closed/suspended/unknown program renders the exact same
// StatusPanel a GET would, and never calls joinProgram; public-api's own 409/404 checks are
// the second line of defense for the race where status changes between that check and this
// request landing (mapJoinResult's `panel` case, just below).
if (Astro.request.method === "POST" && outcome.kind === "active") {
  const form = await Astro.request.formData();
  formValues = {
    first_name: String(form.get("first_name") ?? ""),
    last_name: String(form.get("last_name") ?? ""),
    email: String(form.get("email") ?? ""),
  };
  const joinResult = await joinProgram(inviteCode as string, {
    first_name: formValues.first_name,
    last_name: formValues.last_name,
    email: formValues.email,
    consent: form.get("consent") === "true",
  });
  joinOutcome = mapJoinResult(joinResult);
}

// A join outcome always carries its own real status (201/202/422/409/404/503) and overrides
// the GET-derived one — including 422, which still re-renders the active shell's form, just
// not at 200.
Astro.response.status = joinOutcome ? joinOutcome.status : outcome.status;

// <title> carries the merchant's name ONLY in the active state (task-7-brief.md) — every other
// outcome gets the same fixed string, so `unpublished`/`suspended` stay indistinguishable down
// to the rendered <title> (task-7-design.md §8's audit).
const title = outcome.kind === "active" ? outcome.program.display_name : "LoyaltyGo";
const description = "Karta lojalnościowa LoyaltyGo.";
---

<Base title={title} description={description}>
  <main class="status-shell">
    {
      joinOutcome && joinOutcome.kind === "panel" ? (
        <StatusPanel state={joinOutcome.state} />
      ) : outcome.kind === "active" ? (
        <>
          <ProgramCard brand={deriveBrand(outcome.program)} />
          <JoinForm values={formValues} result={joinOutcome && joinOutcome.kind !== "panel" ? joinOutcome : undefined} />
        </>
      ) : (
        <StatusPanel state={outcome.state} />
      )
    }
    <footer class="status-mark">Loyalty<b>Go</b></footer>
  </main>
</Base>

<style>
  /* Shell lives here, not in StatusPanel, because Task 8's active state (ProgramCard + join
     form) reuses the same centring and the same LoyaltyGo mark (task-7-design.md §7). */
  .status-shell {
    min-height: 100svh; /* svh, not vh: iOS's collapsing address bar must not reflow the page */
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-8);
    padding: var(--space-10) var(--space-8) var(--space-11); /* optical centring, raised */
  }

  .status-mark {
    width: min(100%, 380px);
    font-size: 13px;
    font-weight: 590;
    letter-spacing: -0.02em;
    color: var(--text-3);
  }

  .status-mark b {
    color: var(--accent); /* the one brand trace on an otherwise brandless screen */
    font-weight: inherit;
  }
</style>
