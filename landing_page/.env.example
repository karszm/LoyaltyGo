# Supabase project for the waitlist form.
# Copy to .env and fill with values from: Supabase Dashboard -> Project Settings -> API.
# The anon key is safe to expose in the browser; table access is limited by RLS
# (see backend/supabase/migrations/0001_waitlist.sql).
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
