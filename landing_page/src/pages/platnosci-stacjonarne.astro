---
import Base from '../layouts/Base.astro';
import WalletCard from '../components/WalletCard.astro';
---

<Base
  title="Płatności stacjonarne z TpayGO | LoyaltyGo"
  description="LoyaltyGo działa wewnątrz aplikacji TpayGO. Karta lojalnościowa dołącza do transakcji, a punkty naliczają się automatycznie, bez dodatkowych kroków przy kasie."
>
  <header class="nav">
    <div class="container nav-inner">
      <a href="/" class="wordmark" aria-label="LoyaltyGo, strona główna">
        Loyalty<span class="wordmark-go">Go</span>
      </a>
      <a class="nav-back" href="/">Strona główna</a>
    </div>
  </header>

  <main>
    <!-- Hero -->
    <section class="phero">
      <div class="container">
        <h1 class="phero-h1">Płatności stacjonarne z&nbsp;TpayGO</h1>
        <p class="phero-lead">
          TpayGO zamienia dowolny telefon z Androidem lub iOS w punkt przyjmowania płatności:
          BLIK, Apple Pay, Google Pay i karty, bez tradycyjnego terminala. LoyaltyGo działa
          wewnątrz tej samej aplikacji. Lojalność staje się częścią płatności, a nie osobnym
          procesem.
        </p>
      </div>
    </section>

    <!-- Two buttons -->
    <section class="pbuttons">
      <div class="container pbuttons-grid">
        <div class="pbuttons-copy">
          <h2 class="p-h2">Dwa przyciski w aplikacji. To cała obsługa.</h2>
          <ul class="p-list">
            <li>
              <strong>Skanuj kartę lojalnościową.</strong> Klientka pokazuje kartę z Walleta,
              kasjer skanuje ją tym samym telefonem, którym przyjmuje płatność.
            </li>
            <li>
              <strong>Wygeneruj kartę lojalnościową.</strong> Nowa klientka skanuje kod QR
              zaproszenia i po chwili ma kartę Twojego programu w swoim Wallecie.
            </li>
          </ul>
          <p class="p-note">
            Żadnego drugiego urządzenia ani drugiej aplikacji. Lojalność mieszka tam, gdzie
            płatność.
          </p>
        </div>
        <figure class="pbuttons-stage">
          <div class="softpos" role="img" aria-label="Ilustracja: ekran aplikacji płatniczej z kwotą i przyciskami programu lojalnościowego">
            <div class="softpos-head">
              <span class="softpos-title">Nowa transakcja</span>
              <span class="softpos-amount mono">150,00 zł</span>
            </div>
            <div class="softpos-methods">
              <span class="softpos-chip">BLIK</span>
              <span class="softpos-chip">Apple Pay</span>
              <span class="softpos-chip">Google Pay</span>
              <span class="softpos-chip">Karta</span>
            </div>
            <div class="softpos-divider" aria-hidden="true"></div>
            <button type="button" class="softpos-btn softpos-btn--scan" tabindex="-1">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <path d="M3.5 6V4.5A1 1 0 0 1 4.5 3.5H6M12 3.5h1.5a1 1 0 0 1 1 1V6M14.5 12v1.5a1 1 0 0 1-1 1H12M6 14.5H4.5a1 1 0 0 1-1-1V12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M3 9h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
              Skanuj kartę lojalnościową
            </button>
            <button type="button" class="softpos-btn softpos-btn--gen" tabindex="-1">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <rect x="3" y="3" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/>
                <rect x="10" y="3" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/>
                <rect x="3" y="10" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/>
                <path d="M10 10h2v2h-2zM13 13h2v2h-2z" fill="currentColor"/>
              </svg>
              Wygeneruj kartę lojalnościową
            </button>
          </div>
          <figcaption>Widok ilustracyjny</figcaption>
        </figure>
      </div>
    </section>

    <!-- Flow diagram -->
    <section class="pflow">
      <div class="container">
        <h2 class="p-h2">Jak punkty naliczają się same</h2>
        <p class="p-lead">
          Karta lojalnościowa dołącza do transakcji w momencie płatności. Resztą zajmują się
          systemy, nie kasjer.
        </p>

        <ol class="flow" aria-label="Przepływ naliczania punktów: od płatności do zaktualizowanego salda">
          <li class="flow-node">
            <span class="flow-num mono" aria-hidden="true">1</span>
            <h3>Płatność w TpayGO</h3>
            <p>Klientka skanuje kod QR i płaci BLIK-iem, Apple Pay lub kartą. Kasjer skanuje jej kartę z Walleta.</p>
            <span class="flow-payload mono" aria-hidden="true">kwota + ID karty</span>
          </li>
          <li class="flow-arrow" aria-hidden="true">
            <svg width="40" height="16" viewBox="0 0 40 16" fill="none">
              <path d="M0 8h34M34 8l-6-5M34 8l-6 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </li>
          <li class="flow-node">
            <span class="flow-num mono" aria-hidden="true">2</span>
            <h3>Tpay łączy transakcję z kartą</h3>
            <p>Karta lojalnościowa jest automatycznie dopięta do zrealizowanej płatności.</p>
            <span class="flow-payload mono" aria-hidden="true">transakcja zrealizowana</span>
          </li>
          <li class="flow-arrow" aria-hidden="true">
            <svg width="40" height="16" viewBox="0 0 40 16" fill="none">
              <path d="M0 8h34M34 8l-6-5M34 8l-6 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </li>
          <li class="flow-node">
            <span class="flow-num mono" aria-hidden="true">3</span>
            <h3>LoyaltyGo nalicza punkty</h3>
            <p>Tpay wysyła potwierdzenie transakcji do naszego systemu. Punkty naliczają się według Twojego przelicznika.</p>
            <span class="flow-payload mono" aria-hidden="true">+15 pkt</span>
          </li>
          <li class="flow-arrow" aria-hidden="true">
            <svg width="40" height="16" viewBox="0 0 40 16" fill="none">
              <path d="M0 8h34M34 8l-6-5M34 8l-6 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </li>
          <li class="flow-node">
            <span class="flow-num mono" aria-hidden="true">4</span>
            <h3>Karta w Wallecie aktualizuje saldo</h3>
            <p>Klientka widzi nowe punkty na karcie, zanim schowa telefon do torebki.</p>
            <span class="flow-payload mono" aria-hidden="true">saldo: 240 pkt</span>
          </li>
        </ol>

        <p class="flow-footnote">
          Kasjer nie wykonuje żadnego dodatkowego kroku poza skanem karty. Nieudana płatność
          nie nalicza punktów, więc salda zawsze zgadzają się z kasą.
        </p>
      </div>
    </section>

    <!-- Benefits -->
    <section class="pbenefits">
      <div class="container pbenefits-grid">
        <div>
          <h2 class="p-h2">Co to zmienia w Twoim biznesie</h2>
          <ul class="p-list">
            <li>
              <strong>Zero nowego sprzętu.</strong> Telefon, który przyjmuje płatności, obsługuje
              też lojalność.
            </li>
            <li>
              <strong>Zero pracy przy kasie.</strong> Punkty naliczają się automatycznie z każdej
              transakcji, bez ręcznego wpisywania kwot.
            </li>
            <li>
              <strong>Salda zgodne z kasą.</strong> Punkty naliczają się wyłącznie za
              zrealizowane płatności, a zwrot cofa naliczenie.
            </li>
          </ul>
        </div>
        <div class="pbenefits-stage" aria-label="Ilustracja: karta lojalnościowa z naliczonymi punktami">
          <WalletCard state="points" />
          <span class="demo-chip-sub">Widok ilustracyjny</span>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="pcta">
      <div class="container pcta-inner">
        <h2 class="pcta-h2">Lojalność w tej samej aplikacji, którą przyjmujesz płatności.</h2>
        <a class="btn btn--amber btn--lg" href="/#zapisz-sie">Dołącz do listy startowej</a>
      </div>
    </section>
  </main>

  <footer class="pfooter">
    <div class="container pfooter-inner">
      <span class="wordmark">Loyalty<span class="wordmark-go">Go</span></span>
      <a href="mailto:kontakt@loyaltygo.pl">Kontakt: kontakt@loyaltygo.pl</a>
    </div>
  </footer>
</Base>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(8, 9, 10, 0.8);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .wordmark {
    font-size: 16px;
    font-weight: 640;
    letter-spacing: -0.02em;
    color: var(--text-1);
  }

  .wordmark-go {
    color: var(--accent);
  }

  .nav-back {
    font-size: 13px;
    line-height: 19.5px;
    letter-spacing: -0.13px;
    color: var(--text-3);
    transition: color 140ms ease;
  }

  .nav-back:hover {
    color: var(--text-1);
  }

  .phero {
    padding-block: var(--space-11) var(--space-10);
  }

  .phero-h1 {
    font-size: clamp(34px, 4.6vw, 52px);
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.02em;
    max-width: 20ch;
  }

  .phero-lead {
    margin-top: var(--space-8);
    font-size: 19px;
    line-height: 30px;
    color: var(--text-2);
    max-width: 62ch;
  }

  .p-h2 {
    font-size: clamp(26px, 3vw, 36px);
    line-height: 1.15;
    max-width: 24ch;
  }

  .p-lead {
    margin-top: var(--space-7);
    font-size: 16px;
    line-height: 26px;
    color: var(--text-3);
    max-width: 60ch;
  }

  .pbuttons,
  .pflow,
  .pbenefits {
    padding-block: var(--space-11);
    border-top: 1px solid var(--border);
  }

  .pbuttons-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: var(--space-10);
    align-items: center;
  }

  .p-list {
    list-style: none;
    margin-top: var(--space-9);
    display: flex;
    flex-direction: column;
  }

  .p-list li {
    font-size: 15px;
    line-height: 24px;
    letter-spacing: -0.165px;
    color: var(--text-3);
    padding-block: var(--space-6);
  }

  .p-list li + li {
    border-top: 1px solid var(--border);
  }

  .p-list strong {
    color: var(--text-1);
    font-weight: 590;
  }

  .p-note {
    margin-top: var(--space-8);
    font-size: 14px;
    line-height: 21px;
    color: var(--text-4);
  }

  .pbuttons-stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
  }

  .pbuttons-stage figcaption {
    font-size: 12px;
    line-height: 16.8px;
    color: var(--text-4);
  }

  .softpos {
    width: min(320px, 100%);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-2xl);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .softpos-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-6);
  }

  .softpos-title {
    font-size: 13px;
    line-height: 19.5px;
    color: var(--text-3);
  }

  .softpos-amount {
    font-size: 22px;
    font-weight: 640;
    color: var(--text-1);
  }

  .softpos-methods {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .softpos-chip {
    font-size: 11px;
    font-weight: 590;
    line-height: 16px;
    color: var(--text-3);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    padding: var(--space-1) var(--space-5);
  }

  .softpos-divider {
    height: 1px;
    background: var(--border);
  }

  .softpos-btn {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-5) var(--space-6);
    border-radius: var(--radius-lg);
    font-size: 14px;
    font-weight: 590;
    letter-spacing: -0.13px;
    cursor: default;
    pointer-events: none;
  }

  .softpos-btn--scan {
    background: var(--accent);
    color: #ffffff;
  }

  .softpos-btn--gen {
    border: 1px solid var(--border-strong);
    color: var(--text-2);
  }

  .pflow .flow {
    list-style: none;
    margin-top: var(--space-10);
    display: flex;
    align-items: stretch;
    gap: var(--space-5);
  }

  .flow-node {
    flex: 1;
    min-width: 0;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: var(--space-7);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .flow-num {
    width: 26px;
    height: 26px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-strong);
    display: grid;
    place-items: center;
    font-size: 12px;
    font-weight: 590;
    color: var(--text-2);
  }

  .flow-node h3 {
    font-size: 15px;
    font-weight: 590;
    letter-spacing: -0.165px;
  }

  .flow-node p {
    font-size: 13px;
    line-height: 19.5px;
    letter-spacing: -0.13px;
    color: var(--text-3);
  }

  .flow-payload {
    margin-top: auto;
    align-self: flex-start;
    font-size: 11px;
    line-height: 16px;
    color: var(--text-2);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: var(--space-1) var(--space-4);
  }

  .flow-arrow {
    align-self: center;
    color: var(--text-4);
    flex-shrink: 0;
  }

  .flow-footnote {
    margin-top: var(--space-9);
    font-size: 14px;
    line-height: 22px;
    color: var(--text-4);
    max-width: 62ch;
  }

  .pbenefits-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--space-10);
    align-items: center;
  }

  .pbenefits-stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
  }

  .demo-chip-sub {
    font-size: 10px;
    font-weight: 590;
    line-height: 15px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    padding: var(--space-1) var(--space-5);
  }

  .pcta {
    border-top: 1px solid var(--border);
    padding-block: var(--space-11);
    text-align: center;
  }

  .pcta-h2 {
    font-size: clamp(26px, 3.4vw, 40px);
    line-height: 1.15;
    max-width: 26ch;
    margin: 0 auto var(--space-9);
  }

  .pfooter {
    border-top: 1px solid var(--border);
    padding-block: var(--space-9);
  }

  .pfooter-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-8);
    font-size: 13px;
    line-height: 19.5px;
  }

  .pfooter-inner a {
    color: var(--text-3);
    transition: color 140ms ease;
  }

  .pfooter-inner a:hover {
    color: var(--text-1);
  }

  @media (max-width: 900px) {
    .pflow .flow {
      flex-direction: column;
      align-items: stretch;
    }

    .flow-arrow {
      transform: rotate(90deg);
      align-self: flex-start;
      margin-left: var(--space-8);
    }
  }

  @media (max-width: 860px) {
    .pbuttons-grid,
    .pbenefits-grid {
      grid-template-columns: 1fr;
    }

    .pbuttons-stage,
    .pbenefits-stage {
      align-items: flex-start;
    }
  }
</style>
