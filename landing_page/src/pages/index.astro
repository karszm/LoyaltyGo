<script>
  // LTV calculator — transparent arithmetic on the merchant's own numbers.
  const avgIn = document.getElementById('calc-avg') as HTMLInputElement | null;
  const visitsIn = document.getElementById('calc-visits') as HTMLInputElement | null;
  const returnIn = document.getElementById('calc-return') as HTMLInputElement | null;

  const fmt = new Intl.NumberFormat('pl-PL');

  function plural(n: number, one: string, few: string, many: string) {
    if (n === 1) return one;
    const d = n % 10;
    const h = n % 100;
    return d >= 2 && d <= 4 && (h < 12 || h > 14) ? few : many;
  }

  function recalc() {
    if (!avgIn || !visitsIn || !returnIn) return;
    const avg = Number(avgIn.value);
    const visits = Number(visitsIn.value);
    const ret = Number(returnIn.value) / 100;

    const nonReturning = Math.round(visits * (1 - ret));
    const converted = Math.max(1, Math.round(nonReturning * 0.1));
    const extraVisits = converted * 8; // returning every ~6 weeks ≈ 8 visits/year
    const yearly = Math.round((extraVisits * avg) / 100) * 100;

    (document.getElementById('calc-avg-out') as HTMLElement).textContent = `${fmt.format(avg)} zł`;
    (document.getElementById('calc-visits-out') as HTMLElement).textContent = fmt.format(visits);
    (document.getElementById('calc-return-out') as HTMLElement).textContent = `${returnIn.value}%`;
    (document.getElementById('calc-amount') as HTMLElement).textContent = `+${fmt.format(yearly)} zł`;
    (document.getElementById('calc-breakdown') as HTMLElement).textContent =
      `${fmt.format(nonReturning)} ${plural(nonReturning, 'klientka', 'klientki', 'klientek')} bez powrotu → ` +
      `${fmt.format(converted)} ${plural(converted, 'zaczyna', 'zaczynają', 'zaczyna')} wracać → ` +
      `ok. ${fmt.format(extraVisits)} ${plural(extraVisits, 'dodatkowa wizyta', 'dodatkowe wizyty', 'dodatkowych wizyt')} w roku`;
  }

  [avgIn, visitsIn, returnIn].forEach((el) => el?.addEventListener('input', recalc));
  recalc();

  // Waitlist signup: inserts into the Supabase `waitlist` table (see
  // backend/supabase/migrations/0001_waitlist.sql). Configure PUBLIC_SUPABASE_URL and
  // PUBLIC_SUPABASE_ANON_KEY in landing_page/.env (template: .env.example).
  const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL as string | undefined;
  const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string | undefined;
  const CONTACT_FALLBACK =
    'Nie udało się zapisać adresu. Napisz do nas: kontakt@loyaltygo.pl, a dodamy Cię do listy.';

  const signupForm = document.getElementById('signup-form') as HTMLFormElement | null;
  const signupEmail = document.getElementById('signup-email') as HTMLInputElement | null;
  const signupError = document.getElementById('signup-error') as HTMLElement | null;
  const signupSuccess = document.getElementById('signup-success') as HTMLElement | null;

  function showSignupError(msg: string) {
    if (!signupForm || !signupError) return;
    signupForm.classList.add('is-invalid');
    signupEmail?.setAttribute('aria-invalid', 'true');
    signupError.textContent = msg;
    signupError.hidden = false;
    signupEmail?.setAttribute('aria-describedby', 'signup-error signup-hint');
  }

  function clearSignupError() {
    signupForm?.classList.remove('is-invalid');
    signupEmail?.removeAttribute('aria-invalid');
    signupEmail?.setAttribute('aria-describedby', 'signup-hint');
    if (signupError) signupError.hidden = true;
  }

  signupEmail?.addEventListener('input', clearSignupError);

  signupForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!signupEmail || !signupForm || !signupSuccess) return;

    const email = signupEmail.value.trim();
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
      showSignupError('Podaj poprawny adres e-mail, na przykład salon@twojafirma.pl.');
      signupEmail.focus();
      return;
    }

    if (!navigator.onLine) {
      showSignupError('Brak połączenia z internetem. Spróbuj ponownie po odzyskaniu sieci.');
      return;
    }

    const submitBtn = signupForm.querySelector('.signup-submit') as HTMLButtonElement | null;
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Zapisujemy…';
    }

    try {
      if (!SUPABASE_URL || !SUPABASE_ANON_KEY) throw new Error('missing_config');

      const res = await fetch(`${SUPABASE_URL}/rest/v1/waitlist`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          apikey: SUPABASE_ANON_KEY,
          Authorization: `Bearer ${SUPABASE_ANON_KEY}`,
          Prefer: 'return=minimal',
        },
        body: JSON.stringify({ email }),
        signal: AbortSignal.timeout(10000),
      });

      // 409 = unique-constraint hit: the address is already on the list. That is a success
      // for the visitor, not an error.
      if (!res.ok && res.status !== 409) throw new Error(String(res.status));

      signupForm.hidden = true;
      signupSuccess.hidden = false;
      signupSuccess.querySelector('h3')?.setAttribute('tabindex', '-1');
      (signupSuccess.querySelector('h3') as HTMLElement | null)?.focus();
    } catch {
      showSignupError(CONTACT_FALLBACK);
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Zapisz się';
      }
    }
  });
</script>
