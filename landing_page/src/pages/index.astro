---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "LoyaltyGo | Klienci, którzy chcą do Ciebie wracać";
const pageDescription =
  "Program lojalnościowy w Apple Wallet i Google Wallet dla małych firm. Bez dodatkowej aplikacji, sprzętu i wdrożenia IT.";

const merchantAppUrl = "/panel";

const benefits = [
  {
    title: "Klient nie potrzebuje aplikacji",
    text: "Karta trafia do aplikacji portfel(Wallet), obok biletów i kart, których już używa.",
  },
  {
    title: "Nie potrzebujesz sprzętu",
    text: "Lojalność zintegrowana jest z aplikacją oraz rozwiązaniem SoftPos od Tpay.",
  },
  {
    title: "Uruchamiasz po swojemu, szybciej niż myślisz",
    text: "Twój program może być gotowy w zaledwie kilka kliknięć.",
  },
];

const steps = [
  {
    action: "Zaproś",
    title: "Jeden QR przy kasie",
    text: "Klient skanuje kod aparatem, podaje imię i e-mail, a karta trafia prosto do jego Wallet.",
    detail: "Bez pobierania aplikacji",
    tone: "light",
  },
  {
    action: "Rozpoznaj",
    title: "Karta przy płatności",
    text: "Przy kolejnej wizycie skanujesz kartę w SoftPOS. Transakcja i klient od razu łączą się w jedną historię.",
    detail: "Bez zmiany procesu na kasie",
    tone: "accent",
  },
  {
    action: "Daj powód",
    title: "Punkty rosną. Klient wraca.",
    text: "Saldo aktualizuje się na karcie, a dostępna oferta czeka tam, gdzie klient naprawdę ją znajdzie.",
    detail: "Twoja marka zostaje w telefonie",
    tone: "dark",
  },
];

const customerBenefits = [
  ["Bez haseł", "Jeden skan, imię i e-mail. To cały onboarding."],
  ["Saldo zawsze pod ręką", "Punkty aktualizują się po każdej zarejestrowanej wizycie."],
  ["Oferta bez szukania", "Kupon jest widoczny bezpośrednio na karcie w Wallet."],
  ["Jedna firma, jedna karta", "Dane i punkty pozostają w programie konkretnego miejsca."],
];

const audiences = [
  ["Beauty i fryzjerstwo", "Rytm wizyt, który łatwo zamienić w stałą relację."],
  ["Gabinety", "Regularne przeglądy i zabiegi, o których klient powinien pamiętać."],
  ["Kawiarnie i gastro", "Częste, małe transakcje, które szybko budują przyzwyczajenie."],
  ["Usługi lokalne", "Warsztat, groomer czy studio. Powrót klienta oznacza stabilniejszy miesiąc."],
];

const faqs = [
  [
    "Czy klient musi instalować aplikację?",
    "Nie. Karta działa w Apple Wallet i Google Wallet. Klient dodaje ją po zeskanowaniu kodu QR.",
  ],
  [
    "Czy potrzebuję nowego sprzętu?",
    "Nie. LoyaltyGo integruje się z aplikacją SoftPOS przez SDK. Korzystasz z terminala, który już masz.",
  ],
  [
    "Co widzi klient na karcie?",
    "Twoją markę, aktualne saldo punktów i dostępne oferty w programie Twojej firmy.",
  ],
  [
    "Jak naliczane są punkty?",
    "Ustalasz własny przelicznik. Po rejestracji transakcji saldo klienta aktualizuje się na karcie.",
  ],
  [
    "Jakie dane podaje klient?",
    "W pierwszej wersji tylko imię, nazwisko i e-mail. Szczegóły prawne programu ustalasz zgodnie z rolą administratora danych.",
  ],
  [
    "Czy działa na iPhone i Androidzie?",
    "Tak. Karty są przygotowane dla Apple Wallet i Google Wallet. Integracja z SoftPOS w pierwszej wersji korzysta z SDK iOS.",
  ],
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <a class="skip-link" href="#main">Przejdź do treści</a>

  <header class="site-header" data-header>
    <div class="nav-shell">
      <a class="wordmark" href="#top" aria-label="LoyaltyGo, strona główna">
        <span class="wordmark-mark" aria-hidden="true"><i></i><i></i></span>
        <span>LoyaltyGo</span>
      </a>

      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">
        Menu
      </button>

      <nav id="main-nav" class="main-nav" aria-label="Główna nawigacja">
        <a href="#jak-dziala">Jak działa</a>
        <a href="#korzysci">Korzyści</a>
        <a href="#kalkulator">Kalkulator</a>
        <a href="#faq">FAQ</a>
      </nav>

      <a class="button button--small header-cta" href="#start">Uruchom program</a>
    </div>
  </header>

  <main id="main">
    <section id="top" class="hero section-shell">
      <div class="hero-copy">
        <h1 data-hero-item>Klienci, którzy chcą do Ciebie wracać.</h1>
        <p class="hero-lead" data-hero-item>
          Zamień każdą płatność w początek relacji, która nie wymaga dodatkowego wysiłku.
        </p>
        <div class="hero-actions" data-hero-item>
          <a class="button" href="#start">Uruchom program</a>
          <a class="text-link" href="#jak-dziala">Zobacz jak działa</a>
        </div>
      </div>

      <figure class="hero-media" data-hero-media>
        <img
          src="/images/loyaltygo-hero.webp"
          srcset="/images/loyaltygo-hero-768.webp 768w, /images/loyaltygo-hero-1200.webp 1200w, /images/loyaltygo-hero.webp 1536w"
          sizes="(max-width: 56rem) calc(100vw - 2rem), 50vw"
          width="1536"
          height="1024"
          alt="Telefon z kartą lojalnościową obok terminala SoftPOS w salonie"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
    </section>

    <section class="value-rail section-shell" aria-label="Najważniejsze korzyści">
      {benefits.map((benefit) => (
        <article>
          <h2>{benefit.title}</h2>
          <p>{benefit.text}</p>
        </article>
      ))}
    </section>

    <section class="story section-shell section-space" data-reveal-section>
      <div class="story-copy reveal">
        <p class="kicker">Codzienność małego biznesu</p>
        <h2>Klient płaci. Wychodzi.<br />I znika.</h2>
        <p class="large-copy">
          Kasia zna twarze swoich klientek, ale nie widzi, kto był pierwszy raz i kto nie wrócił od miesięcy.
        </p>
        <p>
          Papierowa karta milczy, a kolejna aplikacja zostaje zapomniana. Bez prostego sposobu na rozpoznanie klienta każda wizyta zaczyna się od zera.
        </p>
      </div>

      <figure class="story-media reveal reveal--late">
        <img
          src="/images/salon-owner.webp"
          width="1098"
          height="1408"
          alt="Właścicielka salonu przy recepcji między wizytami"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </section>

    <section id="korzysci" class="shift-section section-space" data-reveal-section>
      <div class="section-shell">
        <div class="shift-heading reveal">
          <h2>Lojalność nie musi mieszkać w kolejnej aplikacji.</h2>
          <p>
            Jeden kod QR zmienia anonimową transakcję w relację, którą możesz rozwijać przy każdej wizycie.
          </p>
        </div>

        <div class="comparison reveal reveal--late">
          <article class="comparison-old">
            <h3>Kolejna aplikacja</h3>
            <ul>
              <li>Najpierw instalacja</li>
              <li>Potem konto i hasło</li>
              <li>Na końcu ikona, o której łatwo zapomnieć</li>
            </ul>
          </article>
          <article class="comparison-new">
            <h3>LoyaltyGo w Wallet</h3>
            <ul>
              <li>Skan aparatem</li>
              <li>Karta od razu w telefonie</li>
              <li>Punkty i oferty zawsze w jednym miejscu</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section id="jak-dziala" class="steps-section section-shell section-space" data-reveal-section>
      <div class="steps-intro reveal">
        <p class="eyebrow">Jak to działa</p>
        <h2>Trzy naturalne momenty. Żadnej nowej rutyny.</h2>
        <p>
          LoyaltyGo dokłada lojalność do procesu płatności, zamiast budować obok niego osobny świat.
        </p>
      </div>

      <div class="step-stack">
        {steps.map((step) => (
          <article class:list={["step-card", `step-card--${step.tone}`]}>
            <p class="step-action">{step.action}</p>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
            <span>{step.detail}</span>
          </article>
        ))}
      </div>
    </section>

    <section id="kalkulator" class="calculator-section section-space" data-reveal-section>
      <div class="section-shell calculator-grid">
        <div class="calculator-copy reveal">
          <p class="eyebrow">Policz na swoich danych</p>
          <h2>Jedna dodatkowa wizyta ma konkretną wartość.</h2>
          <p>
            Zobacz przykładowy dodatkowy obrót, jeśli część klientów wróci w roku o jeden raz więcej.
          </p>
        </div>

        <form class="calculator reveal reveal--late" data-ltv-form novalidate>
          <div class="field-row">
            <label for="visit-value">Średnia wartość wizyty</label>
            <div class="input-with-unit">
              <input id="visit-value" name="visitValue" type="number" min="1" step="1" value="150" inputmode="decimal" required />
              <span>zł</span>
            </div>
            <small>Wpisz średni rachunek jednego klienta.</small>
          </div>

          <div class="field-row">
            <label for="monthly-clients">Klientów miesięcznie</label>
            <input id="monthly-clients" name="monthlyClients" type="number" min="1" step="1" value="120" inputmode="numeric" required />
            <small>Użyj średniej z kilku ostatnich miesięcy.</small>
          </div>

          <div class="field-row field-row--range">
            <div class="range-label">
              <label for="return-rate">Klienci, którzy wrócą dodatkowy raz</label>
              <output for="return-rate" data-rate-output>10%</output>
            </div>
            <input id="return-rate" name="returnRate" type="range" min="5" max="30" step="1" value="10" />
          </div>

          <button class="button button--dark" type="submit">Policz potencjał</button>
          <p class="form-error" data-form-error role="alert" hidden>Uzupełnij obie wartości liczbami większymi od zera.</p>

          <div class="calc-result" aria-live="polite" aria-atomic="true">
            <span class="calc-result-label">Przykładowy dodatkowy obrót rocznie</span>
            <strong data-result-value>21 600 zł</strong>
            <span class="calc-skeleton" aria-hidden="true"></span>
            <small>Wyliczenie jest scenariuszem, nie gwarancją wyniku.</small>
          </div>
        </form>
      </div>
    </section>

    <section class="customer-section section-shell section-space" data-reveal-section>
      <figure class="customer-media reveal">
        <img
          src="/images/wallet-checkout-ios-orange-cafe-pass.webp"
          srcset="/images/wallet-checkout-ios-orange-cafe-pass-640.webp 640w, /images/wallet-checkout-ios-orange-cafe-pass-960.webp 960w, /images/wallet-checkout-ios-orange-cafe-pass.webp 1448w"
          sizes="(max-width: 56rem) calc(100vw - 2rem), 50vw"
          width="1448"
          height="1086"
          alt="Klient pokazuje kartę lojalnościową w Apple Wallet na pomarańczowym iPhonie przy kasie kawiarni"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="customer-copy reveal reveal--late">
        <h2>Klient lubi to, czego nie musi się uczyć.</h2>
        <div class="customer-benefits">
          {customerBenefits.map(([title, text]) => (
            <article>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="brand-section section-space" data-reveal-section>
      <div class="section-shell brand-grid">
        <div class="brand-copy reveal">
          <h2>To Twoja karta. Klient ma widzieć Twoją markę.</h2>
          <p>
            W panelu ustawiasz nazwę, logo, kolor i zasady punktów. LoyaltyGo pozostaje w tle.
          </p>

          <div class="field-row brand-field">
            <label for="brand-name">Nazwa Twojej firmy</label>
            <input id="brand-name" type="text" value="Studio Forma" maxlength="28" data-brand-input />
            <small>Wpisz nazwę i zobacz ją na przykładowej karcie.</small>
          </div>
        </div>

        <div class="wallet-preview-wrap reveal reveal--late">
          <p class="preview-label">Podgląd karty</p>
          <article class="wallet-pass" aria-label="Interaktywny podgląd karty lojalnościowej">
            <div class="wallet-pass-topline">
              <span class="wallet-pass-mark" aria-hidden="true">L</span>
              <span data-brand-output>Studio Forma</span>
            </div>
            <div class="wallet-pass-balance">
              <span>Przykładowe saldo</span>
              <strong>840</strong>
              <small>punktów</small>
            </div>
            <div class="wallet-pass-offer">
              <span>Oferta na karcie</span>
              <strong>20% na kolejną wizytę</strong>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="audience-section section-shell section-space" data-reveal-section>
      <div class="audience-heading reveal">
        <h2>Najwięcej zyskują miejsca, do których warto wracać.</h2>
      </div>
      <div class="audience-list reveal reveal--late">
        {audiences.map(([title, text]) => (
          <article>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="faq" class="faq-section section-shell section-space" data-reveal-section>
      <div class="faq-heading reveal">
        <h2>Krótko i konkretnie.</h2>
        <p>Najważniejsze odpowiedzi przed uruchomieniem programu.</p>
      </div>

      <div class="faq-list reveal reveal--late">
        {faqs.map(([question, answer], index) => (
          <details open={index === 0}>
            <summary>{question}<span aria-hidden="true"></span></summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section id="start" class="final-cta section-space" data-reveal-section>
      <div class="section-shell final-cta-inner reveal">
        <h2>Następny stały klient zapłaci u Ciebie dziś.</h2>
        <p>Daj mu prosty powód, żeby wrócił.</p>
        <a class="button button--dark" href={merchantAppUrl}>Uruchom program</a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="section-shell footer-grid">
      <div>
        <a class="wordmark" href="#top" aria-label="LoyaltyGo, wróć na górę">
          <span class="wordmark-mark" aria-hidden="true"><i></i><i></i></span>
          <span>LoyaltyGo</span>
        </a>
        <p>Lojalność w Wallet. Prostszy powrót klienta.</p>
      </div>
      <nav aria-label="Linki w stopce">
        <a href="#jak-dziala">Jak działa</a>
        <a href="/polityka-prywatnosci">Prywatność</a>
        <a href="mailto:kontakt@loyaltygo.pl">Kontakt</a>
        <a href={merchantAppUrl}>Panel merchanta</a>
      </nav>
      <p class="copyright">© {new Date().getFullYear()} LoyaltyGo</p>
    </div>
  </footer>

  <script>
    const menuToggle = document.querySelector(".menu-toggle");
    const mainNav = document.querySelector(".main-nav");

    menuToggle?.addEventListener("click", () => {
      const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
      menuToggle.setAttribute("aria-expanded", String(!isOpen));
      mainNav?.classList.toggle("is-open", !isOpen);
    });

    mainNav?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        menuToggle?.setAttribute("aria-expanded", "false");
        mainNav.classList.remove("is-open");
      });
    });

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const revealSections = document.querySelectorAll("[data-reveal-section]");

    if (reducedMotion || !("IntersectionObserver" in window)) {
      revealSections.forEach((section) => section.classList.add("is-visible"));
    } else {
      const revealObserver = new IntersectionObserver(
        (entries, observer) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          });
        },
        { threshold: 0.14 },
      );
      revealSections.forEach((section) => revealObserver.observe(section));
    }

    const calculator = document.querySelector<HTMLFormElement>("[data-ltv-form]");
    const resultValue = calculator?.querySelector<HTMLElement>("[data-result-value]");
    const errorMessage = calculator?.querySelector<HTMLElement>("[data-form-error]");
    const rateInput = calculator?.querySelector<HTMLInputElement>("#return-rate");
    const rateOutput = calculator?.querySelector<HTMLOutputElement>("[data-rate-output]");
    let calculationTimer: number | undefined;

    rateInput?.addEventListener("input", () => {
      if (rateOutput) rateOutput.value = `${rateInput.value}%`;
    });

    calculator?.addEventListener("submit", (event) => {
      event.preventDefault();
      const formData = new FormData(calculator);
      const visitValue = Number(formData.get("visitValue"));
      const monthlyClients = Number(formData.get("monthlyClients"));
      const returnRate = Number(formData.get("returnRate"));
      const valid = visitValue > 0 && monthlyClients > 0 && returnRate > 0;

      if (!valid) {
        if (errorMessage) errorMessage.hidden = false;
        calculator.classList.remove("is-loading");
        return;
      }

      if (errorMessage) errorMessage.hidden = true;
      calculator.classList.add("is-loading");
      window.clearTimeout(calculationTimer);

      calculationTimer = window.setTimeout(() => {
        const annualPotential = visitValue * monthlyClients * 12 * (returnRate / 100);
        if (resultValue) {
          resultValue.textContent = new Intl.NumberFormat("pl-PL", {
            style: "currency",
            currency: "PLN",
            maximumFractionDigits: 0,
          }).format(annualPotential);
        }
        calculator.classList.remove("is-loading");
      }, reducedMotion ? 0 : 380);
    });

    const brandInput = document.querySelector<HTMLInputElement>("[data-brand-input]");
    const brandOutput = document.querySelector<HTMLElement>("[data-brand-output]");

    brandInput?.addEventListener("input", () => {
      if (!brandOutput) return;
      brandOutput.textContent = brandInput.value.trim() || "Twoja firma";
    });
  </script>
</BaseLayout>
