---
import Base from '../layouts/Base.astro';
import WalletCard from '../components/WalletCard.astro';
import LockToast from '../components/LockToast.astro';
import PanelTable from '../components/PanelTable.astro';

// The merchant panel does not exist yet; its footer entry is a "(wkrótce)" placeholder.
// Waitlist submissions go to Supabase — configure landing_page/.env (see .env.example).

const faq = [
  {
    q: 'Czy moi klienci muszą instalować aplikację?',
    a: 'Nie. Karta lojalnościowa działa w Apple Wallet i Google Wallet, czyli w aplikacjach, które Twoi klienci mają już na telefonie.',
  },
  {
    q: 'Czy potrzebuję nowego sprzętu?',
    a: 'Nie. Lojalność działa na terminalu, na którym już przyjmujesz płatności.',
  },
  {
    q: 'Ile trwa uruchomienie?',
    a: 'Kilka minut: rejestracja, kreator karty, gotowe. Kod QR do druku dostajesz od razu.',
  },
  {
    q: 'Co z RODO?',
    // TODO(legal): treść odpowiedzi do potwierdzenia z obsługą prawną przed publikacją.
    a: 'Zbieramy tylko imię, nazwisko i adres e-mail, wyłącznie na potrzeby Twojego programu.',
  },
  {
    q: 'Co widzi klient na karcie?',
    a: 'Twoją markę, saldo punktów i aktualne oferty.',
  },
  {
    q: 'Czy mogę wysłać ofertę jednemu, konkretnemu klientowi?',
    a: 'Tak. Widzisz jego historię wizyt i tworzysz kupon imienny, który trafia tylko na jego kartę.',
  },
  {
    q: 'Czy klienci z iPhone’em i Androidem są obsługiwani tak samo?',
    a: 'Tak. Obsługujemy oba systemy: Apple Wallet i Google Wallet.',
  },
];
---

<Base
  title="LoyaltyGo | Program lojalnościowy w Apple Wallet i Google Wallet"
  description="Zamień jednorazowe wizyty w trwałe relacje. Karta lojalnościowa w Wallecie klienta, punkty z każdej transakcji i kupony imienne. Bez aplikacji, nowego sprzętu i wdrożenia IT."
>
  <header class="nav">
    <div class="container nav-inner">
      <a href="#" class="wordmark" aria-label="LoyaltyGo, strona główna">
        Loyalty<span class="wordmark-go">Go</span>
      </a>
      <nav class="nav-links" aria-label="Nawigacja">
        <a href="#jak-to-dziala">Trzy kroki</a>
        <a href="#kalkulator">Policz zysk</a>
        <a href="#panel">Twoje klientki</a>
        <a href="#platnosci">Płatności</a>
        <a href="#faq">FAQ</a>
      </nav>
    </div>
  </header>

  <main>
    <!-- 1 · Hero -->
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <h1 class="hero-h1">Zamień jednorazowe wizyty w&nbsp;trwałe relacje.</h1>
          <p class="hero-sub">
            LoyaltyGo to program lojalnościowy działający w Apple Wallet i Google Wallet.
            Nie wymaga aplikacji, nowego sprzętu ani wdrożenia IT. Konfiguracja zajmuje
            kilka minut.
          </p>
          <div class="hero-actions">
            <a class="btn btn--amber" href="#zapisz-sie">Dołącz do listy startowej</a>
            <a class="btn btn--ghost" href="#jak-to-dziala">Zobacz, jak to działa</a>
          </div>
          <p class="hero-fineprint">Karta nosi markę Twojej firmy, nie naszą.</p>
        </div>
        <div class="hero-stage" aria-label="Ilustracja: karta lojalnościowa salonu w Apple Wallet i powiadomienie na ekranie blokady">
          <WalletCard state="points" class="hero-card" />
          <LockToast
            class="hero-toast"
            text="Punkty za ostatnią wizytę zostały dodane. Twoje saldo: 240 pkt."
          />
        </div>
      </div>
    </section>

    <!-- 2 · Act I — the invisible customer -->
    <section class="act problem">
      <div class="container">
        <h2 class="act-h2">Pani Kasia zna swoje klientki tylko z&nbsp;widzenia.</h2>
        <div class="problem-grid">
          <div class="problem-story">
            <p class="story-lead">
              Pani Kasia prowadzi salon fryzjerski. Codziennie obsługuje kilkanaście osób, ale nie
              wie, kto był u niej pierwszy raz ani kto nie wrócił od trzech miesięcy. Każda
              klientka, która nie wraca, oznacza pustą godzinę w&nbsp;kalendarzu.
            </p>
            <ul class="pain-list">
              <li>
                <strong>Nie wiesz, kim są Twoi klienci.</strong> Płacą i znikają. Nie zostawiają
                danych, kontaktu ani możliwości zaproszenia ich ponownie.
              </li>
              <li>
                <strong>Aplikacji nikt nie zainstaluje.</strong> Własna aplikacja kosztuje
                dziesiątki tysięcy złotych, a klienci nie chcą kolejnej ikony na telefonie.
              </li>
              <li>
                <strong>Pieczątki nie budują biznesu.</strong> Papierowa karta ginie w portfelu
                i nie dostarcza żadnej wiedzy o tym, kto, kiedy i za ile kupuje.
              </li>
            </ul>
          </div>
          <figure class="problem-figure">
            <PanelTable variant="anonymous" />
            <figcaption>Cała wiedza pani Kasi o dzisiejszych klientkach. Widok ilustracyjny.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 3 · Act II — the turn -->
    <section class="act turn">
      <div class="container">
        <p class="turn-bridge">
          Karta lojalnościowa czeka już w telefonie każdej klientki.
          <span class="turn-bridge-answer">W Apple Wallet i Google Wallet.</span>
        </p>

        <div class="pillars">
          <div class="pillar">
            <h3>Klientka nie instaluje niczego</h3>
            <p>
              Karta trafia do Walleta, z którego korzysta na co dzień, obok kart pokładowych
              i&nbsp;biletów.
            </p>
          </div>
          <div class="pillar">
            <h3>Ty nie kupujesz sprzętu</h3>
            <p>Lojalność działa na terminalu, na którym już przyjmujesz płatności.</p>
          </div>
          <div class="pillar">
            <h3>Zero wdrożenia IT</h3>
            <p>
              Kreator karty w panelu webowym: nazwa, logo, kolory, przelicznik punktów. Program
              rusza w kilka minut.
            </p>
          </div>
        </div>

        <div class="versus">
          <h3 class="versus-h3">To nie są kolejne e-pieczątki</h3>
          <div class="versus-table" role="table" aria-label="Porównanie: e-pieczątki a LoyaltyGo">
            <div class="versus-row versus-row--head" role="row">
              <span role="columnheader" class="versus-dim"></span>
              <span role="columnheader">E-pieczątki <span class="versus-note">(aplikacja / strona)</span></span>
              <span role="columnheader">LoyaltyGo <span class="versus-note">(karta w Wallecie)</span></span>
            </div>
            <div class="versus-row" role="row">
              <span role="rowheader" class="versus-dim">Gdzie mieszka lojalność</span>
              <span role="cell">W cudzej aplikacji, którą trzeba zainstalować i pamiętać</span>
              <span role="cell" class="versus-us">W Apple Wallet i Google Wallet, obok kart płatniczych i biletów</span>
            </div>
            <div class="versus-row" role="row">
              <span role="rowheader" class="versus-dim">Kontakt z klientką</span>
              <span role="cell">Żaden albo mailing, który ginie w spamie</span>
              <span role="cell" class="versus-us">Push z Walleta: nowy kupon i saldo na ekranie blokady</span>
            </div>
            <div class="versus-row" role="row">
              <span role="rowheader" class="versus-dim">Kiedy klientka o Tobie myśli</span>
              <span role="cell">Kiedy sama sobie przypomni o aplikacji</span>
              <span role="cell" class="versus-us">Kiedy telefon sam jej o Tobie przypomni</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4 · How it works -->
    <section class="how" id="jak-to-dziala">
      <div class="container">
        <h2 class="section-h2">Program w trzech krokach</h2>
        <ol class="steps">
          <li class="step">
            <div class="step-visual step-visual--photo">
              <img
                src="/images/recepcja-qr.jpg"
                alt="Klientka z telefonem przy recepcji salonu, obok stojak z kodem QR programu lojalnościowego"
                loading="lazy"
                width="1600"
                height="900"
              />
            </div>
            <h3>Klientka skanuje kod QR przy kasie</h3>
            <p>Podaje imię i adres e-mail. Karta z Twoim logo trafia do jej Walleta.</p>
          </li>
          <li class="step">
            <div class="step-visual" aria-label="Ilustracja: SoftPOS skanuje kartę i nalicza punkty">
              <div class="scan-frame">
                <span class="scan-corner scan-corner--tl" aria-hidden="true"></span>
                <span class="scan-corner scan-corner--tr" aria-hidden="true"></span>
                <span class="scan-corner scan-corner--bl" aria-hidden="true"></span>
                <span class="scan-corner scan-corner--br" aria-hidden="true"></span>
                <svg class="scan-qr" width="64" height="64" viewBox="0 0 21 21" aria-hidden="true">
                  <rect width="21" height="21" fill="#fff" rx="1" />
                  <path
                    fill="#1c0d13"
                    d="M2 2h5v5H2zM3 3v3h3V3zM14 2h5v5h-5zM15 3v3h3V3zM2 14h5v5H2zM3 15v3h3V15zM9 2h1v1H9zM11 2h1v2h-1zM9 4h2v1H9zM12 5h1v1h-1zM9 6h1v2H9zM11 7h2v1h-1v1h-1zM2 9h1v1H2zM4 9h2v1H4zM7 9h1v2H7zM9 9h1v1H9zM12 9h2v1h1v1h-2v1h-1zM16 9h1v1h-1zM18 9h1v2h-1zM3 11h1v1H3zM5 11h1v2H5zM9 11h1v2H9zM11 12h1v1h-1zM15 12h1v2h-1zM17 12h1v1h-1zM2 12h1v1H2zM13 13h1v1h-1zM9 14h2v1h-1v2h-1zM12 15h2v1h-2zM16 15h3v1h-1v1h-2zM11 16h1v1h-1zM13 17h2v1h-2zM9 18h1v1H9zM11 18h1v1h-1zM16 18h3v1h-3z"
                  />
                </svg>
              </div>
              <div class="scan-result">
                <span class="scan-dot" aria-hidden="true"></span>
                <span class="mono">+15 pkt</span>
                <span class="scan-who">· Marta W.</span>
              </div>
            </div>
            <h3>Ty skanujesz kartę przy płatności</h3>
            <p>Punkty naliczają się automatycznie, a saldo aktualizuje się natychmiast.</p>
          </li>
          <li class="step">
            <div class="step-visual" aria-label="Ilustracja: kupon −25% na strzyżenie na karcie lojalnościowej">
              <div class="coupon-slip">
                <span class="coupon-slip-badge">Kupon</span>
                <span class="coupon-slip-value mono">−25%</span>
                <span class="coupon-slip-what">na strzyżenie</span>
              </div>
            </div>
            <h3>Klientka wraca po nagrodę</h3>
            <p>Kupon na karcie przypomina o Tobie przy każdym otwarciu Walleta.</p>
          </li>
        </ol>
        <p class="how-micro">
          Po stronie klientki cała konfiguracja to jeden skan aparatem.
        </p>
      </div>
    </section>

    <!-- 5 · LTV + calculator -->
    <section class="ltv" id="kalkulator">
      <div class="container">
        <h2 class="section-h2">
          Nie zgaduj, czy klientki wrócą. Policz, ile jest warta ta, która wraca.
        </h2>
        <p class="story-lead ltv-lead">
          Klientka, która przychodzi raz i znika, zostawia u Ciebie 150 zł. Ta sama klientka,
          wracająca co 6 tygodni przez dwa lata, zostawia ponad 2&nbsp;500 zł. Ta różnica to
          relacja, którą możesz zbudować.
        </p>

        <dl class="levers">
          <div class="lever">
            <dt>Częstsze powroty</dt>
            <dd>
              Punkty dają klientce powód, aby wrócić właśnie do Ciebie.
              <em>Więcej wizyt rocznie.</em>
            </dd>
          </div>
          <div class="lever">
            <dt>Wyższy koszyk</dt>
            <dd>
              Klientka, która zbiera punkty, chętniej dobiera dodatkową usługę.
              <em>Wyższa średnia transakcja.</em>
            </dd>
          </div>
          <div class="lever">
            <dt>Dłuższa relacja</dt>
            <dd>
              Twoja marka mieszka w telefonie klientki między wizytami.
              <em>Klientka zostaje na lata.</em>
            </dd>
          </div>
          <div class="lever">
            <dt>Tańszy marketing</dt>
            <dd>
              Oferta na karcie trafia do osób, które już Ci zaufały.
              <em>Przychód bez budżetu reklamowego.</em>
            </dd>
          </div>
          <div class="lever">
            <dt>Trafiona oferta zamiast spamu</dt>
            <dd>
              Znasz historię wizyt, więc proponujesz to, czego klientka potrzebuje.
              <em>Wyższa konwersja, bez wypisów z newslettera.</em>
            </dd>
          </div>
        </dl>

        <div class="calc">
          <div class="calc-inputs">
            <h3 class="calc-h3">Oblicz na własnych liczbach</h3>
            <div class="calc-field">
              <label for="calc-avg">Średnia wartość wizyty</label>
              <div class="calc-row">
                <input type="range" id="calc-avg" min="20" max="500" step="10" value="150" />
                <output for="calc-avg" id="calc-avg-out" class="mono">150 zł</output>
              </div>
            </div>
            <div class="calc-field">
              <label for="calc-visits">Klientek w miesiącu</label>
              <div class="calc-row">
                <input type="range" id="calc-visits" min="10" max="600" step="10" value="250" />
                <output for="calc-visits" id="calc-visits-out" class="mono">250</output>
              </div>
            </div>
            <div class="calc-field">
              <label for="calc-return">Ile procent klientek dziś wraca (Twój szacunek)</label>
              <div class="calc-row">
                <input type="range" id="calc-return" min="5" max="80" step="5" value="40" />
                <output for="calc-return" id="calc-return-out" class="mono">40%</output>
              </div>
            </div>
          </div>
          <div class="calc-result">
            <p class="calc-scenario">
              Jeśli <strong>co dziesiąta z niewracających</strong> klientek z jednego miesiąca
              zacznie wracać co 6 tygodni, razem zostawią u Ciebie w ciągu roku dodatkowo:
            </p>
            <p class="calc-amount mono" id="calc-amount" aria-live="polite">+18 000 zł</p>
            <p class="calc-breakdown" id="calc-breakdown">
              150 klientek bez powrotu → 15 zaczyna wracać → ok. 120 dodatkowych wizyt w roku
            </p>
            <p class="calc-note">
              Prosta arytmetyka na Twoich liczbach, nie cudzy benchmark.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 6 · The card journey (customer side) -->
    <section class="journey-section">
      <div class="container journey-inner">
        <div class="journey-copy">
          <h2 class="section-h2">Wygoda, której klientka nie musi się uczyć</h2>
          <ul class="journey-list">
            <li><strong>Bez aplikacji i haseł.</strong> Wystarczy skan, imię i adres e-mail.</li>
            <li><strong>Punkty zawsze widoczne.</strong> Saldo rośnie po każdej wizycie.</li>
            <li><strong>Nagrody bez formalności.</strong> Kupon jest widoczny bezpośrednio na karcie.</li>
          </ul>
          <span class="demo-chip">Widok ilustracyjny</span>
        </div>
        <div class="journey-deck" aria-label="Trzy stany karty lojalnościowej: po zapisie, po wizytach, z kuponem">
          <div class="journey-card journey-card--fresh">
            <span class="journey-step">Po zapisie</span>
            <WalletCard state="fresh" />
          </div>
          <div class="journey-card journey-card--points">
            <span class="journey-step">Po trzech wizytach</span>
            <WalletCard state="points" />
          </div>
          <div class="journey-card journey-card--coupon">
            <span class="journey-step">Z kuponem imiennym</span>
            <WalletCard state="coupon" />
          </div>
        </div>
      </div>
    </section>

    <!-- 7 · Merchant panel -->
    <section class="panel" id="panel">
      <div class="container">
        <h2 class="section-h2">Poznaj wszystkie swoje klientki</h2>
        <div class="panel-grid">
          <figure class="panel-figure">
            <PanelTable variant="named" />
            <figcaption>Lista klientek w panelu LoyaltyGo. Widok ilustracyjny.</figcaption>
          </figure>
          <ul class="panel-features">
            <li>
              <strong>Lista klientek.</strong> Punkty i data ostatniej wizyty. Widzisz, kto
              przestaje wracać, zanim zniknie na dobre.
            </li>
            <li>
              <strong>Kreator karty.</strong> Logo, kolory i opis. Karta wygląda jak Twoja marka.
            </li>
            <li>
              <strong>Kupony jednorazowe.</strong> „−25% w środy” tworzysz w minutę.
            </li>
            <li>
              <strong>Oferty imienne.</strong> Kupon skrojony pod konkretną klientkę, prosto na jej
              kartę.
            </li>
            <li>
              <strong>Historia transakcji.</strong> Ile punktów naliczono, które oferty zadziałały.
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 7b · Stationary payments with TpayGO -->
    <section class="payments" id="platnosci">
      <div class="container">
        <h2 class="section-h2">Lojalność wbudowana w TpayGO</h2>
        <p class="payments-lead">
          LoyaltyGo działa wewnątrz aplikacji TpayGO, która zamienia telefon w punkt
          przyjmowania płatności. Karta lojalnościowa dołącza do transakcji w momencie
          płatności, a punkty naliczają się automatycznie.
        </p>
        <ol class="payments-flow" aria-label="Przepływ: płatność, potwierdzenie, punkty">
          <li class="payments-node">
            <h3>Płatność</h3>
            <p>Klientka płaci, kasjer skanuje jej kartę z Walleta.</p>
            <span class="payments-payload mono" aria-hidden="true">kwota + ID karty</span>
          </li>
          <li class="payments-arrow" aria-hidden="true">
            <svg width="32" height="16" viewBox="0 0 32 16" fill="none"><path d="M0 8h26M26 8l-5-4M26 8l-5 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </li>
          <li class="payments-node">
            <h3>Potwierdzenie</h3>
            <p>Tpay wysyła potwierdzenie transakcji do LoyaltyGo.</p>
            <span class="payments-payload mono" aria-hidden="true">transakcja zrealizowana</span>
          </li>
          <li class="payments-arrow" aria-hidden="true">
            <svg width="32" height="16" viewBox="0 0 32 16" fill="none"><path d="M0 8h26M26 8l-5-4M26 8l-5 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </li>
          <li class="payments-node">
            <h3>Punkty</h3>
            <p>Saldo rośnie na karcie w Wallecie klientki.</p>
            <span class="payments-payload mono" aria-hidden="true">+15 pkt</span>
          </li>
        </ol>
        <a class="btn btn--ghost" href="/platnosci-stacjonarne">Zobacz, jak działa integracja</a>
      </div>
    </section>

    <!-- 8 · Clienteling -->
    <section class="cliente">
      <div class="container">
        <h2 class="section-h2">Koniec z „Szanowny Kliencie”. Zacznij od „Kasiu, to dla Ciebie”.</h2>
        <div class="cliente-grid">
          <div class="cliente-copy">
            <p class="story-lead">
              Newsletter „−10% na wszystko” ląduje w spamie, bo nie mówi do nikogo konkretnego.
              Wiadomość „Kasiu, minął rok od Twojej higienizacji, odbierz zniżkę 25% na
              kolejną” to nie marketing, lecz wyraz troski. Kasia rezerwuje wizytę jeszcze
              tego samego dnia.
            </p>
            <ol class="cliente-steps">
              <li>
                <strong>Widzisz historię każdej klientki.</strong> Kasia, higienizacja,
                12 miesięcy temu.
              </li>
              <li>
                <strong>Tworzysz ofertę dla konkretnej osoby.</strong> Kupon imienny zamiast
                mailingu do anonimowego segmentu.
              </li>
              <li>
                <strong>Oferta trafia prosto na jej kartę.</strong> Telefon Kasi pokazuje
                powiadomienie z Walleta na ekranie blokady.
              </li>
            </ol>
            <p class="cliente-micro">
              Tak pracują najlepsi doradcy w butikach. Teraz możesz tak pracować z każdym
              klientem.
            </p>
          </div>
          <div class="cliente-stage" aria-label="Ilustracja: imienny kupon jako powiadomienie na ekranie blokady">
            <LockToast text="Kasiu, −25% na higienizację specjalnie dla Ciebie. Pokaż kartę przy wizycie." time="9:41" />
            <div class="cliente-tags">
              <span class="tag"><span class="tag-dot tag-dot--green" aria-hidden="true"></span>właściwa oferta: usługa, którą klientka zna</span>
              <span class="tag"><span class="tag-dot tag-dot--green" aria-hidden="true"></span>właściwy moment: rytm wizyt, nie przypadek</span>
              <span class="tag"><span class="tag-dot tag-dot--green" aria-hidden="true"></span>właściwy ton: imię i konkret</span>
            </div>
            <span class="demo-chip">Widok ilustracyjny</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 9 · Act III close -->
    <section class="act finale">
      <div class="container">
        <div class="finale-panel">
