---
import BaseLayout from "../layouts/BaseLayout.astro";
import RadianceBackground from "../components/RadianceBackground.astro";
import { COMPANY } from "../lib/company";

const pageTitle = "Program lojalnościowy w Apple i Google Wallet | LoyaltyGo";
const pageDescription =
  "Program lojalnościowy w Apple Wallet i Google Wallet dla małych firm. Klient nie instaluje aplikacji, a kartę z Twoim logo i kod QR do druku masz w kilka minut.";

const merchantAppUrl = "https://app.loyaltygo.pl";
const ctaLabel = "Stwórz swoją kartę";

const benefits = [
  {
    title: "Klient niczego nie instaluje",
    text: "Karta zapisuje się w portfelu, który jego telefon już ma. Wystarczy zeskanować kod aparatem.",
  },
  {
    title: "Program tylko Twojej firmy",
    text: "Karta nosi Twoje logo i kolor. Twoi klienci nie trafiają do wspólnej bazy z innymi firmami.",
  },
  {
    title: "Gotowe w kilka minut",
    text: "Kartę ustawiasz sam w panelu. Kod QR na kartce A4 drukujesz na zwykłej drukarce.",
  },
];

const steps = [
  {
    action: "Zaprojektuj",
    title: "Twoja karta w panelu",
    text: "Ustawiasz nazwę, logo, kolor i liczbę punktów za każdą złotówkę. Podgląd pokazuje kartę tak, jak zobaczy ją klient.",
    detail: "Kilka minut w przeglądarce",
    tone: "light",
  },
  {
    action: "Wydrukuj",
    title: "Jeden QR przy kasie",
    text: "Panel przygotowuje kartkę A4 z nazwą Twojej firmy i kodem QR. Drukujesz ją na zwykłej drukarce i wieszasz przy kasie.",
    detail: "Kod jest stały, drukujesz go raz",
    tone: "accent",
  },
  {
    action: "Zaproś",
    title: "Karta w telefonie klienta",
    text: "Klient skanuje kod aparatem, podaje imię, nazwisko i e-mail, a karta trafia prosto do portfela w jego telefonie.",
    detail: "Bez pobierania aplikacji",
    tone: "dark",
  },
];

const customerBenefits = [
  ["Bez aplikacji i haseł", "Skan aparatem i krótki formularz. Tyle trwa dołączenie."],
  ["Zawsze przy sobie", "Karta leży w portfelu telefonu, obok kart płatniczych."],
  ["Karta wraca po zmianie telefonu", "Wystarczy podać e-mail na stronie zaproszenia."],
  ["Minimum danych", "Tylko imię, nazwisko i e-mail. Bez numeru telefonu i daty urodzenia."],
];

const audiences = [
  ["Beauty i fryzjerstwo", "Klientka wraca co sześć tygodni. Albo idzie do salonu obok."],
  ["Gabinety", "Pacjent przychodzi raz na pół roku. Przez cały ten czas Twoja karta jest w jego telefonie."],
  ["Kawiarnie i gastro", "Kawa codziennie, ale niekoniecznie u Ciebie. Karta przechyla szalę na Twoją korzyść."],
  ["Usługi lokalne", "Warsztat, groomer czy studio: stały klient to przewidywalny kalendarz."],
];

const faqs = [
  [
    "Czy klient musi instalować aplikację?",
    "Nie. Karta zapisuje się w cyfrowym portfelu: na iPhonie w aplikacji Portfel (Apple Wallet), na Androidzie w Portfelu Google. Klient dodaje ją po zeskanowaniu kodu QR.",
  ],
  [
    "Co dostaję zaraz po rejestracji?",
    "Kreator karty, w którym ustawiasz nazwę, logo, kolor i liczbę punktów za złotówkę, oraz kod QR na kartce A4 do wydrukowania. Klienci mogą dołączać od razu po wydrukowaniu kodu.",
  ],
  [
    "Co widzi klient na karcie?",
    "Twoje logo i nazwę oraz aktualne saldo punktów.",
  ],
  [
    "Jakie dane podaje klient?",
    "Tylko imię, nazwisko i e-mail. Nie łączymy ich z programami innych firm.",
  ],
  [
    "Czy klienci zobaczą inne firmy z LoyaltyGo?",
    "Nie. Każda firma ma osobny program. Dane i punkty Twoich klientów nie trafiają do innych programów, a klient nie widzi katalogu innych firm.",
  ],
  [
    "Czy działa na iPhonie i Androidzie?",
    "Tak, klient może mieć dowolny z nich. Kartę ustawiasz w panelu, który działa w przeglądarce.",
  ],
  [
    "Co, jeśli klient zmieni telefon?",
    "Na stronie zaproszenia wybiera „Odzyskaj kartę” i podaje swój e-mail. Na ten adres przychodzi link do karty z zachowanymi punktami.",
  ],
];

// --- Dane strukturalne -------------------------------------------------------
// FAQPage nie daje już wyników rozszerzonych w SERP-ie dla stron komercyjnych
// (Google wyciął to w 2023). Wartość jest w jednoznacznym parowaniu
// pytanie -> odpowiedź, które modele językowe wyciągają chętniej niż prozę.
const ORG_ID = `${COMPANY.url}/#organization`;

const orgLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": ORG_ID,
  name: COMPANY.brand,
  url: COMPANY.url,
  logo: `${COMPANY.url}/images/logo-dark.png`,
  email: COMPANY.email,
  // sameAs: dopisać, gdy powstaną realne profile (LinkedIn, katalogi SaaS).
  // To one sklejają "LoyaltyGo" w encję; pusta tablica nic nie wnosi.
};

const appLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: COMPANY.brand,
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web, iOS, Android",
  description: pageDescription,
  url: COMPANY.url,
  publisher: { "@id": ORG_ID },
  featureList: [
    "Karta lojalnościowa w Apple Wallet i Google Wallet",
    "Dołączanie klienta przez kod QR przy kasie",
    "Panel merchanta z własnym brandingiem karty",
  ],
  // offers: dodać razem ze stroną /cennik.
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(([question, answer]) => ({
    "@type": "Question",
    name: question,
    acceptedAnswer: { "@type": "Answer", text: answer },
  })),
};
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(orgLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(appLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />
  </Fragment>

  <a class="skip-link" href="#main">Przejdź do treści</a>

  <header class="site-header" data-header>
    <div class="nav-shell">
      <a class="wordmark" href="#top" aria-label="LoyaltyGo, strona główna">
        <img class="wordmark-logo wordmark-logo--light" src="/images/logo-light.png" alt="" width="599" height="160" />
        <img class="wordmark-logo wordmark-logo--dark" src="/images/logo-dark.png" alt="" width="610" height="160" />
      </a>

      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">
        Menu
      </button>

      <nav id="main-nav" class="main-nav" aria-label="Główna nawigacja">
        <a href="#jak-dziala">Jak działa</a>
        <a href="#kalkulator">Kalkulator</a>
        <a href="#faq">Pytania</a>
      </nav>

      <a class="button button--small header-cta" href={merchantAppUrl}>{ctaLabel}</a>
    </div>
  </header>

  <main id="main">
    <section id="top" class="hero section-shell">
      <RadianceBackground />
      <div class="hero-copy">
        <h1 data-hero-item><span>Karta lojalnościowa</span> <span>w telefonie klienta.</span> <span>Gotowa w kilka minut.</span></h1>
        <p class="hero-lead" data-hero-item>
          Klient skanuje kod przy kasie i Twoja karta trafia do jego cyfrowego portfela Apple lub Google,
          bez instalowania aplikacji. W panelu widzisz każdego klienta, który dołączył.
        </p>
        <div class="hero-actions" data-hero-item>
          <a class="button" href={merchantAppUrl}>{ctaLabel}</a>
          <a class="button button--outline" href="#jak-dziala">Zobacz, jak to działa</a>
        </div>
      </div>

    </section>

    <section class="value-rail section-shell" aria-label="Najważniejsze korzyści">
      {benefits.map((benefit) => (
        <article>
          <h2>{benefit.title}</h2>
          <p>{benefit.text}</p>
        </article>
      ))}
    </section>

    <section class="story section-shell section-space" data-reveal-section>
      <div class="story-copy reveal">
        <p class="kicker">Codzienność małego biznesu</p>
        <h2>Klient płaci. Wychodzi.<br />I znika.</h2>
        <p class="large-copy">
          W małej firmie stałych klientów zna się z twarzy. Tych, którzy przestali przychodzić, nikt nie zauważa…
        </p>
        <p>
          Papierowa karta z pieczątkami nie powie, kto nie był od trzech miesięcy, a aplikacji małej firmy nikt nie zainstaluje. Klient odchodzi po cichu, a firma widzi to dopiero w niższym obrocie.
        </p>
      </div>

      <figure class="story-media reveal reveal--late">
        <img
          src="/images/salon-owner.webp"
          srcset="/images/salon-owner-512.webp 512w, /images/salon-owner-768.webp 768w, /images/salon-owner.webp 1098w"
          sizes="(max-width: 56rem) min(100vw - 2rem, 36rem), min(746px, 54vw)"
          width="1098"
          height="1408"
          alt="Właścicielka salonu przy recepcji między wizytami"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </section>

    <section id="korzysci" class="shift-section section-space" data-reveal-section>
      <div class="section-shell">
        <div class="shift-heading reveal">
          <h2>Twoi klienci mają już aplikację lojalnościową i jest nią cyfrowy portfel.</h2>
          <p>
            Jeden kod QR przy kasie i klient, który właśnie zapłacił, ma Twoją kartę w telefonie.
          </p>
        </div>

        <div class="comparison reveal reveal--late">
          <article class="comparison-old">
            <h3>Papierowa karta z pieczątkami</h3>
            <ul>
              <li>Zostaje w domu albo ginie</li>
              <li>Nic nie mówi Ci o kliencie</li>
              <li>Po zgubieniu przepada razem z pieczątkami</li>
            </ul>
          </article>
          <article class="comparison-new">
            <h3>Twoja karta w cyfrowym portfelu</h3>
            <ul>
              <li>Jest w telefonie, który klient ma zawsze przy sobie</li>
              <li>W panelu widzisz imię każdego klienta</li>
              <li>Po zmianie telefonu klient odzyskuje ją e-mailem</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section id="jak-dziala" class="steps-section section-shell section-space" data-reveal-section>
      <div class="steps-intro reveal">
        <p class="eyebrow">Jak to działa</p>
        <h2>Trzy kroki do pierwszej karty</h2>
        <p>
          Wszystko ustawiasz sam w panelu. Pierwszy klient może dołączyć, gdy tylko wydrukujesz kod.
        </p>
        <a class="button" href={merchantAppUrl}>{ctaLabel}</a>
      </div>

      <div class="step-stack">
        {steps.map((step) => (
          <article class:list={["step-card", `step-card--${step.tone}`]}>
            <p class="step-action">{step.action}</p>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
            <span>{step.detail}</span>
          </article>
        ))}
      </div>
    </section>

    <section id="kalkulator" class="calculator-section section-space" data-reveal-section>
      <div class="section-shell calculator-grid">
        <div class="calculator-copy reveal">
          <p class="eyebrow">Policz na swoich danych</p>
          <h2>Jedna wizyta więcej w roku. Policz, ile to złotych.</h2>
          <p>
            Wpisz swoje liczby i zobacz, ile obrotu dają nowi klienci, którzy wrócą do Ciebie jeszcze raz.
          </p>
        </div>

        <form class="calculator reveal reveal--late" data-ltv-form novalidate>
          <div class="field-row">
            <label for="visit-value">Średnia wartość wizyty</label>
            <div class="input-with-unit">
              <input id="visit-value" name="visitValue" type="number" min="1" step="1" value="150" inputmode="decimal" required />
              <span>zł</span>
            </div>
            <small>Wpisz średni rachunek jednego klienta.</small>
          </div>

          <div class="field-row">
            <label for="monthly-clients">Nowych klientów miesięcznie</label>
            <input id="monthly-clients" name="monthlyClients" type="number" min="1" step="1" value="40" inputmode="numeric" required />
            <small>Osoby, które były u Ciebie pierwszy raz.</small>
          </div>

          <div class="field-row field-row--range">
            <div class="range-label">
              <label for="return-rate">Jaka część z nich wróci jeszcze raz (Twoje założenie)</label>
              <output for="return-rate" data-rate-output>10%</output>
            </div>
            <input id="return-rate" name="returnRate" type="range" min="5" max="30" step="1" value="10" />
          </div>

          <button class="button button--dark" type="submit">Policz dodatkowy obrót</button>
          <p class="form-error" data-form-error role="alert" hidden>Uzupełnij obie wartości liczbami większymi od zera.</p>

          <div class="calc-result" aria-live="polite" aria-atomic="true">
            <span class="calc-result-label">Przykładowy dodatkowy obrót rocznie</span>
            <strong data-result-value>7200&nbsp;zł</strong>
            <span class="calc-skeleton" aria-hidden="true"></span>
            <small>To przykład, nie gwarancja wyniku.</small>
          </div>

          <a class="button calc-cta" href={merchantAppUrl}>{ctaLabel}</a>
        </form>
      </div>
    </section>

    <section class="customer-section section-shell section-space" data-reveal-section>
      <figure class="customer-media reveal">
        <img
          src="/images/wallet-checkout-ios-orange-cafe-pass.webp"
          srcset="/images/wallet-checkout-ios-orange-cafe-pass-640.webp 640w, /images/wallet-checkout-ios-orange-cafe-pass-960.webp 960w, /images/wallet-checkout-ios-orange-cafe-pass.webp 1448w"
          sizes="(max-width: 56rem) calc(100vw - 2rem), 50vw"
          width="1448"
          height="1086"
          alt="Karta lojalnościowa Jeżycki Look Hair Studio w cyfrowym portfelu na pomarańczowym iPhonie, przy terminalu w salonie"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="customer-copy reveal reveal--late">
        <h2>Łatwiej dołączyć, niż odmówić.</h2>
        <div class="customer-benefits">
          {customerBenefits.map(([title, text]) => (
            <article>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="brand-section section-space" data-reveal-section>
      <div class="section-shell brand-grid">
        <div class="brand-copy reveal">
          <h2>Twoja marka jest zawsze w portfelu klienta.</h2>
          <p>
            Logo, nazwę i kolor ustawiasz sam w panelu. Klient widzi je za każdym razem, gdy otwiera cyfrowy portfel, także między wizytami.
          </p>

          <div class="field-row brand-field">
            <label for="brand-name">Nazwa Twojej firmy</label>
            <input id="brand-name" type="text" value="Studio Forma" maxlength="28" data-brand-input />
            <small>Wpisz nazwę i zobacz ją na przykładowej karcie.</small>
          </div>
        </div>

        <div class="wallet-preview-wrap reveal reveal--late">
          <p class="preview-label">Podgląd karty</p>
          <article class="wallet-pass" aria-label="Interaktywny podgląd karty lojalnościowej">
            <div class="wallet-pass-topline">
              <span class="wallet-pass-mark" aria-hidden="true" data-brand-mark>S</span>
              <span data-brand-output>Studio Forma</span>
            </div>
            <div class="wallet-pass-balance">
              <span>Przykładowe saldo</span>
              <strong>840</strong>
              <small>punktów</small>
            </div>
            <div class="wallet-pass-member">
              <span>Klient</span>
              <strong>Anna Nowak</strong>
            </div>
          </article>
          <a class="button wallet-preview-cta" href={merchantAppUrl}>{ctaLabel}</a>
        </div>
      </div>
    </section>

    <section class="audience-section section-shell section-space" data-reveal-section>
      <div class="audience-heading reveal">
        <h2>Najwięcej zyskują miejsca, do których warto wracać.</h2>
      </div>
      <div class="audience-list reveal reveal--late">
        {audiences.map(([title, text]) => (
          <article>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="faq" class="faq-section section-shell section-space" data-reveal-section>
      <div class="faq-heading reveal">
        <h2>Zanim założysz program</h2>
      </div>

      <div class="faq-list reveal reveal--late">
        {faqs.map(([question, answer], index) => (
          <details open={index === 0}>
            <summary>{question}<span aria-hidden="true"></span></summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section id="start" class="final-cta section-space" data-reveal-section>
      <div class="section-shell final-cta-inner reveal">
        <h2>Twój następny stały klient zapłaci u Ciebie jeszcze dziś.</h2>
        <p>Niech wyjdzie z Twoją kartą w telefonie.</p>
        <a class="button button--dark" href={merchantAppUrl}>{ctaLabel}</a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="section-shell footer-grid">
      <div>
        <a class="wordmark" href="#top" aria-label="LoyaltyGo, wróć na górę">
          <img class="wordmark-logo" src="/images/logo-dark.png" alt="" width="610" height="160" />
        </a>
        <p>Karta stałego klienta w cyfrowym portfelu Apple i Google.</p>
      </div>
      <nav aria-label="Linki w stopce">
        <a href="#jak-dziala">Jak działa</a>
        <a href="/polityka-prywatnosci">Prywatność</a>
        <a href="mailto:kontakt@loyaltygo.pl">Kontakt</a>
        <a href={merchantAppUrl}>Zaloguj się</a>
      </nav>
      <p class="copyright">© {new Date().getFullYear()} LoyaltyGo</p>
    </div>
  </footer>

  <script>
    const menuToggle = document.querySelector(".menu-toggle");
    const mainNav = document.querySelector(".main-nav");

    menuToggle?.addEventListener("click", () => {
      const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
      menuToggle.setAttribute("aria-expanded", String(!isOpen));
      mainNav?.classList.toggle("is-open", !isOpen);
    });

    mainNav?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        menuToggle?.setAttribute("aria-expanded", "false");
        mainNav.classList.remove("is-open");
      });
    });

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const revealSections = document.querySelectorAll("[data-reveal-section]");

    if (reducedMotion || !("IntersectionObserver" in window)) {
      revealSections.forEach((section) => section.classList.add("is-visible"));
    } else {
      const revealObserver = new IntersectionObserver(
        (entries, observer) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          });
        },
        { threshold: 0.14 },
      );
      revealSections.forEach((section) => revealObserver.observe(section));
    }

    const calculator = document.querySelector<HTMLFormElement>("[data-ltv-form]");
    const resultValue = calculator?.querySelector<HTMLElement>("[data-result-value]");
    const errorMessage = calculator?.querySelector<HTMLElement>("[data-form-error]");
    const rateInput = calculator?.querySelector<HTMLInputElement>("#return-rate");
    const rateOutput = calculator?.querySelector<HTMLOutputElement>("[data-rate-output]");
    let calculationTimer: number | undefined;

    rateInput?.addEventListener("input", () => {
      if (rateOutput) rateOutput.value = `${rateInput.value}%`;
    });

    calculator?.addEventListener("submit", (event) => {
      event.preventDefault();
      const formData = new FormData(calculator);
      const visitValue = Number(formData.get("visitValue"));
      const monthlyClients = Number(formData.get("monthlyClients"));
      const returnRate = Number(formData.get("returnRate"));
      const valid = visitValue > 0 && monthlyClients > 0 && returnRate > 0;

      if (!valid) {
        if (errorMessage) errorMessage.hidden = false;
        calculator.classList.remove("is-loading");
        return;
      }

      if (errorMessage) errorMessage.hidden = true;
      calculator.classList.add("is-loading");
      window.clearTimeout(calculationTimer);

      calculationTimer = window.setTimeout(() => {
        const annualPotential = visitValue * monthlyClients * 12 * (returnRate / 100);
        if (resultValue) {
          resultValue.textContent = new Intl.NumberFormat("pl-PL", {
            style: "currency",
            currency: "PLN",
            maximumFractionDigits: 0,
          }).format(annualPotential);
        }
        calculator.classList.remove("is-loading");
      }, reducedMotion ? 0 : 380);
    });

    const brandInput = document.querySelector<HTMLInputElement>("[data-brand-input]");
    const brandOutput = document.querySelector<HTMLElement>("[data-brand-output]");
    const brandMark = document.querySelector<HTMLElement>("[data-brand-mark]");

    brandInput?.addEventListener("input", () => {
      const name = brandInput.value.trim() || "Twoja firma";
      if (brandOutput) brandOutput.textContent = name;
      if (brandMark) brandMark.textContent = name.charAt(0).toLocaleUpperCase("pl");
    });
  </script>
</BaseLayout>
