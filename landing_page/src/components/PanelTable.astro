---
/**
 * Illustrative merchant-panel client list in Linear's issue-list grammar.
 * `anonymous` = the merchant's knowledge today (Act I); `named` = with LoyaltyGo (Act III).
 */
interface Props {
  variant: 'anonymous' | 'named';
  class?: string;
}

const { variant, class: className } = Astro.props;

const namedRows = [
  { name: 'Ewa Nowak', points: '640', visit: 'wczoraj', status: 'aktywna', tone: 'ok' },
  { name: 'Anna Kowalczyk', points: '480', visit: '5 dni temu', status: 'aktywna', tone: 'ok' },
  { name: 'Marta Wiśniewska', points: '240', visit: '8 tyg. temu', status: 'znika', tone: 'warn' },
  { name: 'Joanna Lis', points: '120', visit: '2 tyg. temu', status: 'aktywna', tone: 'ok' },
];

const anonymousRows = [
  { name: 'Klientka, 11:20', paid: '150 zł' },
  { name: 'Klient, 12:45', paid: '90 zł' },
  { name: 'Klientka, 14:10', paid: '210 zł' },
  { name: 'Klientka, 16:30', paid: '150 zł' },
];
---

<div
  class:list={['panel-table', className]}
  role="table"
  aria-label={variant === 'named' ? 'Lista klientek w panelu LoyaltyGo' : 'Dzisiejsze wizyty bez danych klientek'}
>
  {variant === 'named' ? (
    <>
      <div class="pt-head" role="row">
        <span role="columnheader">Klientka</span>
        <span role="columnheader" class="pt-col-num">Punkty</span>
        <span role="columnheader">Ostatnia wizyta</span>
        <span role="columnheader">Status</span>
      </div>
      {namedRows.map((r) => (
        <div class="pt-row" role="row">
          <span role="cell" class="pt-name">{r.name}</span>
          <span role="cell" class="pt-col-num mono">{r.points}</span>
          <span role="cell" class="pt-visit">{r.visit}</span>
          <span role="cell" class:list={['pt-status', `pt-status--${r.tone}`]}>
            <span class="pt-dot" aria-hidden="true"></span>
            {r.status}
          </span>
        </div>
      ))}
    </>
  ) : (
    <>
      <div class="pt-head" role="row">
        <span role="columnheader">Wizyta</span>
        <span role="columnheader" class="pt-col-num">Zapłacono</span>
        <span role="columnheader">Wróci?</span>
        <span role="columnheader">Kontakt</span>
      </div>
      {anonymousRows.map((r) => (
        <div class="pt-row pt-row--anon" role="row">
          <span role="cell" class="pt-name pt-muted">{r.name}</span>
          <span role="cell" class="pt-col-num mono">{r.paid}</span>
          <span role="cell" class="pt-muted">nie wiadomo</span>
          <span role="cell" class="pt-muted">brak</span>
        </div>
      ))}
    </>
  )}
</div>

<style>
  .panel-table {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--bg-raised);
    overflow: hidden;
    font-size: 13px;
    line-height: 19.5px;
    letter-spacing: -0.13px;
  }

  .pt-head,
  .pt-row {
    display: grid;
    grid-template-columns: 1.5fr 0.7fr 1fr 0.9fr;
    gap: var(--space-6);
    align-items: center;
    padding: var(--space-5) var(--space-6);
  }

  .pt-head {
    font-size: 12px;
    line-height: 16.8px;
    color: var(--text-4);
    border-bottom: 1px solid var(--border);
  }

  .pt-row + .pt-row {
    border-top: 1px solid var(--border);
  }

  .pt-name {
    color: var(--text-1);
    font-weight: 590;
  }

  .pt-visit {
    color: var(--text-3);
  }

  .pt-col-num {
    text-align: right;
    color: var(--text-2);
  }

  .pt-muted {
    color: var(--text-4);
    font-weight: 400;
  }

  .pt-status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--text-3);
  }

  .pt-dot {
    width: 7px;
    height: 7px;
    border-radius: var(--radius-pill);
    flex-shrink: 0;
  }

  .pt-status--ok .pt-dot {
    background: var(--green);
  }

  .pt-status--warn .pt-dot {
    background: var(--red);
  }

  .pt-status--warn {
    color: var(--red);
  }

  @media (max-width: 640px) {
    .pt-head,
    .pt-row {
      grid-template-columns: 1.4fr 0.7fr 1fr;
    }

    .pt-head span:last-child,
    .pt-row > span:last-child {
      display: none;
    }
  }
</style>
