---
/**
 * Illustrative Apple Wallet-style loyalty pass of the fictional salon
 * "Studio Kasia". Three story states: fresh → points → coupon.
 * The raspberry branding is the merchant's, deliberately foreign to the page palette.
 */
interface Props {
  state: 'fresh' | 'points' | 'coupon';
  class?: string;
}

const { state, class: className } = Astro.props;

const points = state === 'fresh' ? '0' : '240';
const lastVisit = state === 'fresh' ? '—' : state === 'points' ? '5 dni temu' : '8 tyg. temu';
---

<div class:list={['wallet-card', `wallet-card--${state}`, className]} aria-label={`Karta lojalnościowa Studio Kasia, ${state === 'fresh' ? 'świeżo dodana' : state === 'points' ? 'z punktami' : 'z kuponem'}`}>
  <div class="wc-head">
    <div class="wc-logo" aria-hidden="true">K</div>
    <div class="wc-brand">
      <span class="wc-name">Studio Kasia</span>
      <span class="wc-kind">Karta stałej klientki</span>
    </div>
    <svg class="wc-wave" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
      <path d="M4.5 6.5a5.5 5.5 0 0 1 9 0M6.5 9.2a3 3 0 0 1 5 0M9 12.4h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  </div>

  <div class="wc-fields">
    <div class="wc-field wc-field--main">
      <span class="wc-label">Punkty</span>
      <span class="wc-value mono">{points}<span class="wc-unit"> pkt</span></span>
    </div>
    <div class="wc-field">
      <span class="wc-label">Ostatnia wizyta</span>
      <span class="wc-small">{lastVisit}</span>
    </div>
  </div>

  {state === 'fresh' && (
    <p class="wc-note">Witaj w programie, Marto. Punkty naliczą się przy pierwszej wizycie.</p>
  )}

  {state === 'coupon' && (
    <div class="wc-coupon">
      <span class="wc-coupon-badge">Kupon</span>
      <p class="wc-coupon-text">Marta, −20% na koloryzację specjalnie dla&nbsp;Ciebie</p>
    </div>
  )}

  <div class="wc-foot">
    <svg class="wc-qr" width="52" height="52" viewBox="0 0 21 21" aria-hidden="true">
      <rect width="21" height="21" fill="#fff" rx="1" />
      <path
        fill="#1c0d13"
        d="M2 2h5v5H2zM3 3v3h3V3zM14 2h5v5h-5zM15 3v3h3V3zM2 14h5v5H2zM3 15v3h3V15zM9 2h1v1H9zM11 2h1v2h-1zM9 4h2v1H9zM12 5h1v1h-1zM9 6h1v2H9zM11 7h2v1h-1v1h-1zM2 9h1v1H2zM4 9h2v1H4zM7 9h1v2H7zM9 9h1v1H9zM12 9h2v1h1v1h-2v1h-1zM16 9h1v1h-1zM18 9h1v2h-1zM3 11h1v1H3zM5 11h1v2H5zM9 11h1v2H9zM11 12h1v1h-1zM15 12h1v2h-1zM17 12h1v1h-1zM2 12h1v1H2zM13 13h1v1h-1zM9 14h2v1h-1v2h-1zM12 15h2v1h-2zM16 15h3v1h-1v1h-2zM11 16h1v1h-1zM13 17h2v1h-2zM9 18h1v1H9zM11 18h1v1h-1zM16 18h3v1h-3z"
      />
    </svg>
    <div class="wc-member">
      <span class="wc-label">Członkini</span>
      <span class="wc-small">Marta Wiśniewska</span>
    </div>
  </div>
</div>

<style>
  .wallet-card {
    width: min(340px, 100%);
    background: linear-gradient(160deg, var(--salon) 0%, var(--salon-deep) 100%);
    border-radius: var(--radius-2xl);
    padding: var(--space-7);
    color: #fff;
    box-shadow: 0 24px 48px -16px rgba(0, 0, 0, 0.55);
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  .wc-head {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .wc-logo {
    width: 34px;
    height: 34px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.14);
    display: grid;
    place-items: center;
    font-weight: 640;
    font-size: 15px;
    letter-spacing: 0;
  }

  .wc-brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    flex: 1;
  }

  .wc-name {
    font-size: 15px;
    font-weight: 640;
    letter-spacing: -0.165px;
    color: #fff;
  }

  .wc-kind {
    font-size: 12px;
    line-height: 16.8px;
    color: var(--salon-tint);
  }

  .wc-wave {
    color: var(--salon-tint);
  }

  .wc-fields {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-6);
  }

  .wc-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .wc-label {
    font-size: 10px;
    font-weight: 590;
    line-height: 15px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--salon-tint);
  }

  .wc-value {
    font-size: 34px;
    line-height: 1.05;
    font-weight: 640;
    color: #fff;
  }

  .wc-unit {
    font-size: 15px;
    font-weight: 460;
    color: var(--salon-tint);
  }

  .wc-small {
    font-size: 13px;
    line-height: 19.5px;
    color: #fff;
  }

  .wc-note {
    font-size: 13px;
    line-height: 19.5px;
    color: var(--salon-tint);
  }

  .wc-coupon {
    border-top: 1px dashed rgba(255, 255, 255, 0.35);
    padding-top: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .wc-coupon-badge {
    align-self: flex-start;
    font-size: 10px;
    font-weight: 590;
    line-height: 15px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: var(--space-1) var(--space-4);
    border-radius: var(--radius-pill);
    background: #fff;
    color: var(--salon-deep);
  }

  .wc-coupon-text {
    font-size: 14px;
    line-height: 21px;
    font-weight: 590;
    color: #fff;
  }

  .wc-foot {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    margin-top: auto;
  }

  .wc-qr {
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .wc-member {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
</style>
