---
/**
 * Illustrative iOS lock-screen notification from Apple Wallet —
 * the channel LoyaltyGo claims: pass updates surfacing on the lock screen.
 */
interface Props {
  text: string;
  time?: string;
  class?: string;
}

const { text, time = 'teraz', class: className } = Astro.props;
---

<div class:list={['lock-toast', className]} role="img" aria-label={`Powiadomienie z Apple Wallet: ${text}`}>
  <div class="lt-icon" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
      <rect x="2" y="3" width="14" height="12" rx="2.5" fill="#fff" fill-opacity="0.9"/>
      <path d="M2 6.5h14" stroke="#8c3a52" stroke-width="1.6"/>
      <path d="M2 9.5h14" stroke="#5e6ad2" stroke-width="1.6"/>
    </svg>
  </div>
  <div class="lt-body">
    <div class="lt-row">
      <span class="lt-app">Wallet · Studio Kasia</span>
      <span class="lt-time">{time}</span>
    </div>
    <p class="lt-text">{text}</p>
  </div>
</div>

<style>
  .lock-toast {
    display: flex;
    gap: var(--space-5);
    align-items: flex-start;
    width: min(340px, 100%);
    padding: var(--space-5) var(--space-6);
    border-radius: var(--radius-2xl);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .lt-icon {
    width: 34px;
    height: 34px;
    border-radius: var(--radius-lg);
    background: #1a1b1e;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .lt-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }

  .lt-row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-6);
    align-items: baseline;
  }

  .lt-app {
    font-size: 12px;
    line-height: 16.8px;
    font-weight: 590;
    color: var(--text-1);
  }

  .lt-time {
    font-size: 12px;
    line-height: 16.8px;
    color: var(--text-3);
  }

  .lt-text {
    font-size: 13px;
    line-height: 19.5px;
    letter-spacing: -0.13px;
    color: var(--text-2);
  }
</style>
